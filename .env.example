# ================= LLM / 多模态 =================
# OpenAI 兼容接口（DeepSeek / Qwen / Moonshot / OpenAI 均可）
LLM_API_KEY=sk-your-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=1024

# ================= 嵌入模型（开源本地） =================
# 本地开源嵌入模型，中文推荐 BAAI/bge-*-zh-v1.5（首次运行自动下载模型）
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=
# 国内下载模型走镜像（留空则用 huggingface.co）
HF_ENDPOINT=https://hf-mirror.com

# 文生图模型（留空则 generate_image 工具返回"未配置"）
IMAGE_MODEL=

# ================= JWT 鉴权 =================
# 生产环境必须替换为强随机串（>= 32 字节）
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ================= 存储 =================
# 本地开发留空走内存；生产(ENVIRONMENT=prod)必须填写
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aigf
REDIS_URL=redis://localhost:6379/0

# 向量库后端：memory | pgvector | milvus（生产禁止 memory；pgvector 需先 docker compose up -d）
VECTOR_STORE_BACKEND=pgvector

# ================= 图参数 =================
MEMORY_RETRIEVE_TOP_K=5
# 真实 bge 嵌入相似度偏高，0.35~0.5 合适；hash 降级用 0.1
MEMORY_IMPORTANCE_THRESHOLD=0.4
HISTORY_WINDOW=12
MAX_REPLY_LENGTH=400

# ================= 主动推送（独立后台任务） =================
ACTIVE_PUSH_ENABLED=false
ACTIVE_PUSH_INTERVAL_SEC=600
ACTIVE_PUSH_MAX_PER_SESSION_PER_DAY=3
ACTIVE_PUSH_CHANCE=0.3

# ================= 风控 / 限流 =================
CHAT_RATE_LIMIT_PER_MIN=30
SESSION_TTL_SEC=604800

# 会话锁：等待获取锁的最长时间 + 锁租约秒数（租约须 > 等待超时、且 > 单轮最长处理耗时）
LOCK_ACQUIRE_TIMEOUT_SEC=10
LOCK_TTL_SEC=120

# 幂等结果缓存时长（同一 client_msg_id 的重试直接返回上次结果，避免重复落库）
IDEMPOTENCY_TTL_SEC=3600

# 认证限流 / 防爆破：每 IP 每分钟认证上限、账号连续失败锁定阈值与时长
AUTH_RATE_LIMIT_PER_MIN=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SEC=900
# 仅在部署于可信反向代理后置 true，才信任 X-Forwarded-For 取真实 IP
TRUST_PROXY_HEADERS=false
