# ===================== 基础 =====================
APP_NAME="AI 伴侣 Agent"
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ===================== LLM（只做决策与解释，不算数字） =====================
LLM_API_KEY=sk-your-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ===================== 嵌入模型（记忆召回） =====================
# hash（离线/测试） | sentence-transformers（本地模型） | openai（兼容服务）
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=
HF_ENDPOINT=https://hf-mirror.com

# ===================== 存储 =====================
# 留空 => 内存仓库（仅演示/测试）；生产必须配置
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/companion
REDIS_URL=redis://localhost:6379/0
# memory | pgvector | milvus（记忆向量检索）
VECTOR_STORE_BACKEND=pgvector

# ===================== 图护栏（防死循环 / 防跑飞） =====================
GRAPH_MAX_ROUNDS=3               # plan→execute→review 的最大轮次
GRAPH_MAX_SKILL_CALLS=12         # 单任务 Skill 调用次数上限
GRAPH_MAX_LLM_CALLS=8            # 单任务 LLM 调用次数上限
GRAPH_MAX_WALL_SECONDS=120       # 单任务墙钟上限
GRAPH_REPEAT_LIMIT=2             # 同一批调用重复几次就判定为打转
GRAPH_NO_PROGRESS_LIMIT=2        # 连续几轮无进展转人工
MAX_SKILL_CALLS_PER_ROUND=4      # 单轮最多执行几个 Skill

# ===================== 重试（只重试可重试错误） =====================
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=0.4
RETRY_MAX_DELAY=8
RETRY_JITTER=0.25

# ===================== SingleFlight（同参合并） =====================
SINGLEFLIGHT_ENABLED=true
SINGLEFLIGHT_TTL=120
SINGLEFLIGHT_WAIT_SEC=8

# ===================== 检查点（断点续跑） =====================
# auto | postgres | sqlite | memory（auto：pg → sqlite → memory 依次尝试）
CHECKPOINT_BACKEND=auto
CHECKPOINT_SQLITE_PATH=data/checkpoints.sqlite3

# ===================== Skill 注册中心 =====================
SKILL_REFRESH_SEC=5              # 版本号轮询间隔（热更新生效上限）
# 逗号分隔的插件包名，包内需暴露 SKILLS = [Skill...]
SKILL_PLUGIN_PACKAGES=

# ===================== MCP（外部资源适配层） =====================
MCP_DATA_DIR=                    # 留空 => app/mcp/data
MCP_HTTP_TIMEOUT_SEC=3
PRICE_FEED_BASE_URL=             # 留空 => 本地价格快照

# ===================== Trace / 审计 =====================
TRACE_ENABLED=true
TRACE_PREVIEW_CHARS=400
TRACE_MAX_SPANS=500

# ===================== 上下文治理 =====================
CONTEXT_MAX_TOKENS=3000
CONTEXT_KEEP_RECENT=6
CONTEXT_SUMMARY_MAX_CHARS=400
CONTEXT_SUMMARY_LLM_ENABLED=false

# ===================== 接入层 =====================
TASK_RATE_LIMIT_PER_MIN=20
LOCK_ACQUIRE_TIMEOUT_SEC=10
LOCK_TTL_SEC=180
IDEMPOTENCY_TTL_SEC=3600

# ===================== 认证 =====================
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
AUTH_RATE_LIMIT_PER_MIN=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SEC=900
TRUST_PROXY_HEADERS=false

# ===================== 运维接口 =====================
# Skill 注册/上下线接口的令牌；留空则整组接口关闭（生产必须配置）
ADMIN_TOKEN=

# 登录态（access 30 分钟，refresh 30 天）
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# 用户头像（本地存储，挂 /media）
MEDIA_DIR=data/media
AVATAR_MAX_MB=2
AVATAR_SIZE=512
AVATAR_QUALITY=85
