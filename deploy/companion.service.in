# deploy/companion.service.in — systemd 单元模板
# 占位符由 install.sh 替换：__USER__ __GROUP__ __PREFIX__ __STATE_DIR__ __PORT__ __WORKERS__
[Unit]
Description=AI Companion Agent (FastAPI + LangGraph)
Documentation=file://__PREFIX__/docs/ARCHITECTURE.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__PREFIX__
EnvironmentFile=__PREFIX__/.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=__PREFIX__/.venv/bin/python -m uvicorn app.main:app \
  --host 127.0.0.1 --port __PORT__ --workers __WORKERS__ \
  --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-server-header
Restart=always
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGINT

# ---- 加固：只允许写 data/ 与状态目录，其余只读 ----
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=__PREFIX__/data __STATE_DIR__
LimitNOFILE=65535

StandardOutput=journal
StandardError=journal
SyslogIdentifier=companion

[Install]
WantedBy=multi-user.target
